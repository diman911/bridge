# Fine-grained GitHub PAT with Issues and Contents: Read and write access
BRIDGE_E2E_GITHUB_TOKEN=put-your-github-pat-here

# GitHub account or organization that owns the dedicated test repository
BRIDGE_E2E_GITHUB_OWNER=put-owner-here

# Dedicated repository used by the E2E test
BRIDGE_E2E_GITHUB_REPO=put-test-repository-here

# Jira Cloud API token authentication for the direct connector suite
BRIDGE_E2E_JIRA_BASE_URL=https://your-site.atlassian.net
BRIDGE_E2E_JIRA_EMAIL=you@example.com
BRIDGE_E2E_JIRA_TOKEN=put-your-jira-api-token-here
BRIDGE_E2E_JIRA_PROJECT_KEY=APP

# Optional Jira Cloud OAuth 2.0 (3LO) connector suite
# BRIDGE_E2E_JIRA_OAUTH_TOKEN=your-short-lived-oauth-access-token
# BRIDGE_E2E_JIRA_OAUTH_CLOUD_ID=your-atlassian-cloud-id

# Optional overrides
# CP_REPO_PATH=D:/Work/workspace/allyx/control-plane
# CP_E2E_PORT=8787
# BRIDGE_E2E_PORT=18887
