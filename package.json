{
  "name": "fairlead-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Fairlead integration bridge — connects recorded sessions and test results to issue trackers, test-management systems, and log backends",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@fairlead/bridge-core && npm run build --workspace=@fairlead/connector-jira --workspace=@fairlead/connector-github --workspace=@fairlead/connector-azure-devops && npm run build --workspace=@fairlead/bridge-worker",
    "test": "vitest run",
    "test:e2e:github": "node --env-file-if-exists=.env.e2e ./node_modules/vitest/vitest.mjs run --config e2e/vitest.config.ts",
    "test:e2e:github:connector": "node --env-file-if-exists=.env.e2e ./node_modules/vitest/vitest.mjs run --config e2e/vitest.config.ts github/connector-github.integration.test.ts",
    "test:e2e:jira:connector": "node --env-file-if-exists=.env.e2e ./node_modules/vitest/vitest.mjs run --config e2e/vitest.config.ts jira/connector-jira.integration.test.ts",
    "test:e2e:jira:oauth": "node --env-file-if-exists=.env.e2e ./node_modules/vitest/vitest.mjs run --config e2e/vitest.config.ts jira/connector-jira.oauth.integration.test.ts",
    "test:e2e:jira:scoped": "node --env-file-if-exists=.env.e2e ./node_modules/vitest/vitest.mjs run --config e2e/vitest.config.ts jira/connector-jira.scoped.integration.test.ts",
    "test:e2e:azure-devops:pat": "node --env-file-if-exists=.env.e2e ./node_modules/vitest/vitest.mjs run --config e2e/vitest.config.ts azure-devops/connector-azure-devops.pat.integration.test.ts",
    "test:e2e:azure-devops:oauth": "node --env-file-if-exists=.env.e2e ./node_modules/vitest/vitest.mjs run --config e2e/vitest.config.ts azure-devops/connector-azure-devops.oauth.integration.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260921.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.39.0"
  }
}
